---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const featured = posts.filter((p) => p.data.featured).slice(0, 4);
const latest = posts.slice(0, 6);

const categoryMap = new Map<string, number>();
for (const p of posts) {
	const c = p.data.category ?? '未分类';
	categoryMap.set(c, (categoryMap.get(c) ?? 0) + 1);
}
const categories = [...categoryMap.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8);

const orgSchema = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: 'YoTradeApi',
	url: 'https://yotradeapi.com',
	logo: 'https://blog.yotradeapi.com/favicon.svg',
	sameAs: ['https://blog.yotradeapi.com/'],
};
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={SITE_TITLE}
			description={SITE_DESCRIPTION}
			canonical="https://blog.yotradeapi.com/"
			keywords={[
				'AI API 中转',
				'Cursor API 中转',
				'Claude Code 国内',
				'OpenAI SDK base_url',
				'Cline 配置',
				'Aider 配置',
				'Codex CLI',
				'Cherry Studio',
				'Claude Sonnet 4.6',
				'Claude Opus 4.7',
			]}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
		<style>
			main {
				width: 980px;
				padding-top: 4.5rem;
			}
			.hero {
				max-width: 760px;
				margin-bottom: 4rem;
			}
			.hero h1 {
				font-size: 3.25rem;
				line-height: 1.08;
				margin: 0 0 1rem;
			}
			.lede {
				font-size: 1.2rem;
				line-height: 1.55;
				color: var(--text-2);
				margin: 0;
			}
			.actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-top: 1.75rem;
			}

			section {
				margin: 0 0 3.5rem;
			}
			.section-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1rem;
				margin: 0 0 1.25rem;
			}
			.section-head h2 {
				font-size: 1.6rem;
				margin: 0;
			}
			.section-head a {
				font-size: 0.9rem;
				white-space: nowrap;
			}

			.grid {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 1rem;
			}
			.grid li {
				display: flex;
			}
			.card {
				display: flex;
				flex-direction: column;
				width: 100%;
				color: var(--text);
				text-decoration: none;
			}
			.card:hover {
				color: var(--text);
			}
			.card .kicker {
				font-size: 0.75rem;
				font-weight: 600;
				color: var(--accent);
				margin-bottom: 0.5rem;
			}
			.card .t {
				font-weight: 600;
				font-size: 1.05rem;
				line-height: 1.35;
				margin-bottom: 0.45rem;
			}
			.card .desc {
				margin: 0 0 0.75rem;
				font-size: 0.9rem;
				line-height: 1.5;
				color: var(--text-2);
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.card .meta {
				margin-top: auto;
				font-size: 0.8rem;
				color: var(--text-3);
			}

			/* 这两个区块固定 4 张卡片，桌面排成一行，避免 3+1 落单 */
			@media (min-width: 900px) {
				.start .grid,
				.featured .grid {
					grid-template-columns: repeat(4, 1fr);
				}
			}
			.start .card .t {
				font-size: 1.1rem;
			}
			.start .card .desc {
				-webkit-line-clamp: 2;
			}

			.categories {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
			}
			.categories a {
				display: inline-flex;
				align-items: baseline;
				gap: 0.35rem;
				padding: 0.45rem 0.95rem;
				border-radius: 980px;
				background: var(--surface-2);
				color: var(--text);
				text-decoration: none;
				font-size: 0.92rem;
				transition: background 0.2s ease, color 0.2s ease;
			}
			.categories a:hover {
				background: var(--accent-soft);
				color: var(--accent);
				text-decoration: none;
			}
			.categories .count {
				font-size: 0.8rem;
				color: var(--text-3);
			}

			@media (max-width: 720px) {
				main {
					padding-top: 2.5rem;
				}
				.hero {
					margin-bottom: 2.75rem;
				}
				.hero h1 {
					font-size: 2.1rem;
				}
				.lede {
					font-size: 1.05rem;
				}
				section {
					margin-bottom: 2.75rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>AI API 中转与开发者工具配置实测</h1>
				<p class="lede">
					围绕 Cursor、Claude Code、Cline、Aider、Cherry Studio、Codex CLI 等真实开发场景，
					记录可复现的 base_url 配置、模型对比、价格追踪与稳定性检查方法。面向中文开发者。
				</p>
				<div class="actions">
					<a class="btn btn-primary" href="https://yotradeapi.com">创建 API Key</a>
					<a class="btn btn-secondary" href="/blog/">浏览全部文章</a>
					<a class="btn btn-secondary" href="/compare/">服务对比</a>
					<a class="btn btn-secondary" href="/pricing-tracker/">价格追踪</a>
				</div>
			</section>

			<section class="start">
				<div class="section-head">
					<h2>新手起步</h2>
				</div>
				<ul class="grid">
					<li>
						<a class="tile card" href="/blog/2026-05-15-cursor-api-relay-recommendation-2026/">
							<span class="kicker">Cursor</span>
							<span class="t">Cursor 怎么接</span>
							<p class="desc">3 步把 Cursor 的 OpenAI Compatible Provider 指向中转网关。</p>
						</a>
					</li>
					<li>
						<a class="tile card" href="/blog/claude-code-mirror-cn-setup/">
							<span class="kicker">Claude Code</span>
							<span class="t">Claude Code 怎么接</span>
							<p class="desc">5 行环境变量让 Claude Code CLI 在国内跑起来。</p>
						</a>
					</li>
					<li>
						<a class="tile card" href="/blog/openai-sdk-base-url-cn/">
							<span class="kicker">OpenAI SDK</span>
							<span class="t">OpenAI SDK 怎么接</span>
							<p class="desc">Python、Node、Go、Rust 四种 SDK 改 base_url 即可。</p>
						</a>
					</li>
					<li>
						<a class="tile card" href="/blog/ai-api-relay-stability-test/">
							<span class="kicker">稳定性</span>
							<span class="t">怎么测稳定性</span>
							<p class="desc">用可复现脚本量化 TTFB、断流率、错误率。</p>
						</a>
					</li>
				</ul>
			</section>

			{featured.length > 0 && (
				<section class="featured">
					<div class="section-head">
						<h2>精选阅读</h2>
					</div>
					<ul class="grid">
						{featured.map((post) => (
							<li>
								<a class="tile card" href={`/blog/${post.id}/`}>
									{post.data.category && <span class="kicker">{post.data.category}</span>}
									<span class="t">{post.data.title}</span>
									<p class="desc">{post.data.description}</p>
									<span class="meta"><FormattedDate date={post.data.pubDate} /></span>
								</a>
							</li>
						))}
					</ul>
				</section>
			)}

			<section>
				<div class="section-head">
					<h2>最新文章</h2>
					<a href="/blog/">查看全部 →</a>
				</div>
				<ul class="grid">
					{latest.map((post) => (
						<li>
							<a class="tile card" href={`/blog/${post.id}/`}>
								{post.data.category && <span class="kicker">{post.data.category}</span>}
								<span class="t">{post.data.title}</span>
								<p class="desc">{post.data.description}</p>
								<span class="meta"><FormattedDate date={post.data.pubDate} /></span>
							</a>
						</li>
					))}
				</ul>
			</section>

			<section>
				<div class="section-head">
					<h2>按分类浏览</h2>
					<a href="/categories/">全部分类 →</a>
				</div>
				<div class="categories">
					{categories.map(([cat, count]) => (
						<a href={`/categories/${encodeURIComponent(cat.toLowerCase().replace(/[\s/]+/g, '-'))}/`}>
							{cat}<span class="count">{count}</span>
						</a>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
