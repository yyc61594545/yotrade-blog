---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = posts[0];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={SITE_TITLE}
			description={SITE_DESCRIPTION}
			canonical="https://blog.yotradeapi.com/"
			keywords={['AI API 中转', 'Cursor API', 'Claude Code', 'OpenAI SDK']}
		/>
		<style>
			main {
				width: 980px;
			}
			.lede {
				max-width: 760px;
			}
			.actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin: 1.5rem 0 2.5rem;
			}
			.actions a {
				border: 1px solid rgb(var(--gray-light));
				border-radius: 6px;
				padding: 0.55rem 0.8rem;
				text-decoration: none;
			}
			.latest {
				border-top: 1px solid rgb(var(--gray-light));
				padding-top: 2rem;
			}
			.meta {
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-top: 1rem;
			}
			.tags span {
				border: 1px solid rgb(var(--gray-light));
				border-radius: 999px;
				color: rgb(var(--gray-dark));
				font-size: 0.85rem;
				padding: 0.2rem 0.55rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>AI API 中转与开发者工具配置实测</h1>
			<p class="lede">
				围绕 Cursor、Claude Code、Cline、Cherry Studio、Codex CLI 等真实开发场景，记录可复现的
				base_url 配置、模型对比、价格追踪与稳定性检查方法。
			</p>
			<div class="actions">
				<a href="/blog/">看最新文章</a>
				<a href="/compare/">查看服务对比</a>
				<a href="/pricing-tracker/">价格追踪</a>
			</div>
			{
				latest && (
					<section class="latest">
						<p class="meta">
							最新更新：<FormattedDate date={latest.data.pubDate} />
						</p>
						<h2>
							<a href={`/blog/${latest.id}/`}>{latest.data.title}</a>
						</h2>
						<p>{latest.data.description}</p>
						<div class="tags">
							{latest.data.tags.map((tag) => (
								<span>{tag}</span>
							))}
						</div>
					</section>
				)
			}
		</main>
		<Footer />
	</body>
</html>
