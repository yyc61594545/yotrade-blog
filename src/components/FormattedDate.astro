---
interface Props {
	date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString('zh-CN', {
			year: 'numeric',
			month: 'long',
			day: 'numeric',
			// frontmatter 里是纯日期，按 UTC 午夜解析；不锁 UTC 的话本地 (PDT) 构建会显示成前一天
			timeZone: 'UTC',
		})
	}
</time>
