---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<nav aria-label="站点导航">
		<a class="brand" href="/">{SITE_TITLE}</a>
		<div class="links">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog">文章</HeaderLink>
			<HeaderLink href="/categories">分类</HeaderLink>
			<HeaderLink href="/tags">标签</HeaderLink>
			<HeaderLink href="/tools">工具</HeaderLink>
			<HeaderLink href="/compare">对比</HeaderLink>
			<HeaderLink href="/pricing-tracker">价格</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
		</div>
	</nav>
</header>
<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--header-bg);
		-webkit-backdrop-filter: saturate(180%) blur(20px);
		backdrop-filter: saturate(180%) blur(20px);
		border-bottom: 1px solid var(--separator);
	}
	nav {
		max-width: 980px;
		height: 48px;
		margin: 0 auto;
		padding: 0 1.25rem;
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}
	.brand {
		font-size: 0.95rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--text);
		text-decoration: none;
		white-space: nowrap;
	}
	.brand:hover {
		color: var(--text);
		text-decoration: none;
	}
	.links {
		display: flex;
		align-items: center;
		gap: 1.35rem;
		margin-left: auto;
		overflow-x: auto;
		scrollbar-width: none;
		-webkit-overflow-scrolling: touch;
	}
	.links::-webkit-scrollbar {
		display: none;
	}
	@media (max-width: 720px) {
		nav {
			padding: 0 1rem;
			gap: 1rem;
		}
		.links {
			gap: 1rem;
			/* 末尾留一点渐隐余量，提示可横向滑动 */
			mask-image: linear-gradient(to right, #000 92%, transparent);
			-webkit-mask-image: linear-gradient(to right, #000 92%, transparent);
			padding-right: 1rem;
		}
	}
</style>
