---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & { currentSlug?: string };

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	canonical,
	keywords = [],
	tags = [],
	category,
	currentSlug,
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const imageURL = heroImage ? new URL(heroImage.src, Astro.site).toString() : undefined;

const tagSlug = (t: string) => t.toLowerCase().replace(/[\s/]+/g, '-');

const ctaHref = `https://yotradeapi.com/?utm_source=blog&utm_medium=cta&utm_content=${currentSlug ?? 'unknown'}#sub`;
const ctaWechatHref = `https://yotradeapi.com/?utm_source=blog&utm_medium=cta_wechat&utm_content=${currentSlug ?? 'unknown'}#contact`;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const related = allPosts
	.filter((p) => p.id !== currentSlug)
	.map((p) => {
		const overlap = p.data.tags.filter((t) => tags.includes(t)).length;
		const sameCat = (p.data.category ?? '') === (category ?? '') ? 1 : 0;
		return { post: p, score: overlap * 2 + sameCat };
	})
	.filter((x) => x.score > 0)
	.sort((a, b) => b.score - a.score || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
	.slice(0, 4)
	.map((x) => x.post);

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: '首页', item: 'https://blog.yotradeapi.com/' },
		{ '@type': 'ListItem', position: 2, name: '文章', item: 'https://blog.yotradeapi.com/blog/' },
		{ '@type': 'ListItem', position: 3, name: title, item: canonicalURL },
	],
};

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	inLanguage: 'zh-CN',
	headline: title,
	description,
	datePublished: pubDate instanceof Date ? pubDate.toISOString() : new Date(pubDate).toISOString(),
	dateModified: updatedDate
		? updatedDate instanceof Date
			? updatedDate.toISOString()
			: new Date(updatedDate).toISOString()
		: pubDate instanceof Date
			? pubDate.toISOString()
			: new Date(pubDate).toISOString(),
	mainEntityOfPage: canonicalURL,
	url: canonicalURL,
	image: imageURL ? [imageURL] : undefined,
	keywords,
	articleSection: tags,
	author: {
		'@type': 'Organization',
		name: 'YoTradeApi',
		url: 'https://yotradeapi.com',
	},
	publisher: {
		'@type': 'Organization',
		name: 'YoTradeApi',
		url: 'https://yotradeapi.com',
	},
};
---

<html lang="zh-CN">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			canonical={canonicalURL}
			keywords={keywords}
			type="article"
		/>
		<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.breadcrumbs {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: 1.25em auto 0;
				padding: 0 1em;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.breadcrumbs a { color: rgb(var(--gray-dark)); text-decoration: none; }
			.breadcrumbs a:hover { color: var(--accent); }
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 { margin: 0 0 0.5em 0; }
			.date { margin-bottom: 0.5em; color: rgb(var(--gray)); }
			.last-updated-on { font-style: italic; }
			.post-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				justify-content: center;
				margin-top: 1em;
			}
			.post-tags a {
				display: inline-block;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 999px;
				padding: 0.15rem 0.6rem;
				font-size: 0.85rem;
				color: rgb(var(--gray-dark));
				text-decoration: none;
			}
			.post-tags a:hover { border-color: var(--accent); color: var(--accent); }
			.cta-box {
				margin: 3em auto 2em;
				padding: 1.5em 1.75em;
				border: 1px solid rgb(var(--gray-light));
				border-left: 4px solid var(--accent);
				border-radius: 8px;
				background: rgba(35, 55, 255, 0.03);
				width: 720px;
				max-width: calc(100% - 2em);
				box-sizing: border-box;
			}
			.cta-box h3 { margin: 0 0 0.5em; font-size: 1.2em; }
			.cta-box p { margin: 0.25em 0; font-size: 0.95em; }
			.cta-box .cta-plans {
				margin-top: 0.75em;
				font-size: 0.88em;
				color: rgb(var(--gray));
				line-height: 1.6;
			}
			.cta-box .actions {
				display: flex;
				gap: 0.75em;
				flex-wrap: wrap;
				margin-top: 0.85em;
			}
			.cta-box .actions a {
				display: inline-block;
				padding: 0.45em 0.95em;
				border-radius: 6px;
				text-decoration: none;
				font-size: 0.95em;
				font-weight: 500;
			}
			.cta-box .primary { background: var(--accent); color: #fff; }
			.cta-box .secondary {
				background: #fff;
				color: var(--accent);
				border: 1px solid rgb(var(--gray-light));
			}
			.related {
				margin: 2.5em auto;
				width: 720px;
				max-width: calc(100% - 2em);
			}
			.related h3 { margin: 0 0 0.75em; font-size: 1.25em; }
			.related ul {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
				gap: 1em;
			}
			.related li {
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				padding: 0.85em 1em;
			}
			.related li a {
				color: rgb(var(--black));
				text-decoration: none;
				font-weight: 500;
				display: block;
				margin-bottom: 0.25em;
			}
			.related li a:hover { color: var(--accent); }
			.related li .desc {
				color: rgb(var(--gray));
				font-size: 0.88em;
				margin: 0;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<nav class="breadcrumbs" aria-label="面包屑">
					<a href="/">首页</a> ›
					<a href="/blog/">文章</a>
					{category && (
						<>
							{' '}›{' '}
							<a href={`/categories/${tagSlug(category)}/`}>{category}</a>
						</>
					)}
				</nav>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{updatedDate && (
								<div class="last-updated-on">
									更新于 <FormattedDate date={updatedDate} />
								</div>
							)}
						</div>
						<h1>{title}</h1>
						<hr />
						{tags.length > 0 && (
							<div class="post-tags">
								{tags.map((t) => (
									<a href={`/tags/${tagSlug(t)}/`}>{t}</a>
								))}
							</div>
						)}
					</div>

					<aside class="cta-box cta-box--top">
						<h3>不想折腾接码和虚拟卡？</h3>
						<p>
							ChatGPT Pro / Claude Max 官方订阅代充。美卡直冲美区官方，5–10 分钟到账，被砍单全额退。
							只接 ≥$100/月 的重度套餐。
						</p>
						<div class="actions">
							<a class="primary" href={ctaHref}>查看套餐与价格 →</a>
						</div>
					</aside>

					<slot />
				</div>
			</article>

			<aside class="cta-box">
				<h3>ChatGPT Pro / Claude Max 官方订阅代充</h3>
				<p>
					接码、虚拟卡、支付被拒、账号被砍——这些环节我们替你走完。美区官方直冲，
					操作期间不查看你的任何使用记录，5–10 分钟回执。
				</p>
				<p class="cta-plans">
					只服务重度用户：ChatGPT Pro ¥1,500/月 · Claude Max 5x ¥750/月 · Max 20x ¥1,500/月 · Claude Pro 年付 ¥1,500/年
				</p>
				<div class="actions">
					<a class="primary" href={ctaHref}>查看套餐与下单 →</a>
					<a class="secondary" href={ctaWechatHref}>微信咨询</a>
				</div>
			</aside>

			{related.length > 0 && (
				<section class="related">
					<h3>相关阅读</h3>
					<ul>
						{related.map((p) => (
							<li>
								<a href={`/blog/${p.id}/`}>{p.data.title}</a>
								<p class="desc">{p.data.description}</p>
							</li>
						))}
					</ul>
				</section>
			)}
		</main>
		<Footer />
	</body>
</html>
