---
import { getCollection, type CollectionEntry } from 'astro:content';
import SocialCard from '../assets/social-card.png';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	currentSlug?: string;
	/** 'page' 用于作者页这类静态页：不显示作者署名和订阅 CTA */
	variant?: 'post' | 'page';
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	canonical,
	keywords = [],
	tags = [],
	category,
	currentSlug,
	variant = 'post',
} = Astro.props;

const isPost = variant === 'post';

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
// 文章页不再放占位图；社交预览与结构化数据统一用站点级品牌卡片
const imageURL = new URL(SocialCard.src, Astro.site).toString();

const toDate = (d: Date | string) => (d instanceof Date ? d : new Date(d));
const published = toDate(pubDate);
const modified = updatedDate ? toDate(updatedDate) : published;
// 只有真的晚于发布日才显示"更新于"，避免每篇都出现两行同一天
const showUpdated = modified.valueOf() > published.valueOf();

const tagSlug = (t: string) => t.toLowerCase().replace(/[\s/]+/g, '-');

const ctaHref = `https://yotradeapi.com/?utm_source=blog&utm_medium=cta&utm_content=${currentSlug ?? 'unknown'}#sub`;
const ctaWechatHref = `https://yotradeapi.com/?utm_source=blog&utm_medium=cta_wechat&utm_content=${currentSlug ?? 'unknown'}#contact`;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const related = allPosts
	.filter((p) => p.id !== currentSlug)
	.map((p) => {
		const overlap = p.data.tags.filter((t) => tags.includes(t)).length;
		const sameCat = (p.data.category ?? '') === (category ?? '') ? 1 : 0;
		return { post: p, score: overlap * 2 + sameCat };
	})
	.filter((x) => x.score > 0)
	.sort((a, b) => b.score - a.score || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
	.slice(0, 4)
	.map((x) => x.post);

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: '首页', item: 'https://blog.yotradeapi.com/' },
		{ '@type': 'ListItem', position: 2, name: '文章', item: 'https://blog.yotradeapi.com/blog/' },
		{ '@type': 'ListItem', position: 3, name: title, item: canonicalURL },
	],
};

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	inLanguage: 'zh-CN',
	headline: title,
	description,
	datePublished: published.toISOString(),
	dateModified: modified.toISOString(),
	mainEntityOfPage: canonicalURL,
	url: canonicalURL,
	image: [imageURL],
	keywords,
	articleSection: tags,
	author: {
		'@type': 'Person',
		name: 'YoTrade',
		url: 'https://blog.yotradeapi.com/author/',
		sameAs: ['https://x.com/yotradellc', 'https://yotradeapi.com', 'https://www.yotradellc.com'],
	},
	publisher: {
		'@type': 'Organization',
		name: 'YoTradeApi',
		url: 'https://yotradeapi.com',
	},
};
---

<html lang="zh-CN">
	<head>
		<BaseHead
			title={title}
			description={description}
			canonical={canonicalURL}
			keywords={keywords}
			type="article"
		/>
		<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
		<style>
			main {
				width: 680px;
			}
			.breadcrumbs {
				font-size: 0.8rem;
				color: var(--text-3);
				margin-bottom: 2rem;
			}
			.breadcrumbs a {
				color: var(--text-2);
				text-decoration: none;
			}
			.breadcrumbs a:hover {
				color: var(--text);
			}
			.breadcrumbs .sep {
				margin: 0 0.4em;
			}
			.post-header {
				margin-bottom: 2.25rem;
			}
			.post-header h1 {
				font-size: 2.6rem;
				line-height: 1.12;
				margin: 0 0 0.9rem;
			}
			.meta {
				font-size: 0.9rem;
				color: var(--text-2);
				margin: 0;
			}
			.meta .updated::before,
			.meta .byline::before {
				content: '·';
				margin: 0 0.5em;
				color: var(--text-3);
			}
			.meta .byline a {
				color: var(--text-2);
				text-decoration: none;
				border-bottom: 1px solid var(--separator);
			}
			.meta .byline a:hover {
				color: var(--accent);
				border-bottom-color: var(--accent);
			}
			.post-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin-top: 1.1rem;
			}
			.post-tags a {
				display: inline-block;
				padding: 0.2rem 0.7rem;
				border-radius: 980px;
				background: var(--surface-2);
				color: var(--text-2);
				font-size: 0.78rem;
				text-decoration: none;
				transition: background 0.2s ease, color 0.2s ease;
			}
			.post-tags a:hover {
				background: var(--accent-soft);
				color: var(--accent);
				text-decoration: none;
			}
			.prose {
				color: var(--text);
			}
			.prose :global(h2) {
				font-size: 1.6rem;
			}
			.prose :global(img) {
				display: block;
				margin: 1.5em auto;
			}
			.prose :global(a) {
				text-decoration: underline;
				text-decoration-color: color-mix(in srgb, var(--accent) 35%, transparent);
				text-underline-offset: 0.15em;
			}
			.prose :global(a:hover) {
				text-decoration-color: var(--accent);
			}
			.cta {
				margin: 2.25rem 0;
				background: var(--surface-2);
				border: none;
			}
			.cta h3 {
				margin: 0 0 0.5rem;
				font-size: 1.1rem;
			}
			.cta p {
				margin: 0.25rem 0;
				font-size: 0.93rem;
				color: var(--text-2);
			}
			.cta .cta-plans {
				margin-top: 0.6rem;
				font-size: 0.85rem;
				color: var(--text-3);
				line-height: 1.6;
			}
			.cta .actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
				margin-top: 1rem;
			}
			.cta--bottom {
				margin-top: 3.5rem;
			}
			.related {
				margin-top: 3rem;
			}
			.related h3 {
				font-size: 1.25rem;
				margin: 0 0 1rem;
			}
			.related ul {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
				gap: 0.85rem;
			}
			.related li a {
				display: block;
				height: 100%;
				color: var(--text);
				text-decoration: none;
			}
			.related li .t {
				display: block;
				font-weight: 600;
				font-size: 0.98rem;
				line-height: 1.35;
				margin-bottom: 0.35rem;
			}
			.related li .desc {
				margin: 0;
				font-size: 0.85rem;
				color: var(--text-2);
				line-height: 1.5;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			@media (max-width: 720px) {
				.post-header h1 {
					font-size: 1.9rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<header class="post-header">
					<nav class="breadcrumbs" aria-label="面包屑">
						<a href="/">首页</a><span class="sep">›</span>
						<a href="/blog/">文章</a>
						{category && (
							<>
								<span class="sep">›</span>
								<a href={`/categories/${tagSlug(category)}/`}>{category}</a>
							</>
						)}
					</nav>
					{category && (
						<a class="eyebrow" href={`/categories/${tagSlug(category)}/`}>{category}</a>
					)}
					<h1>{title}</h1>
					<p class="meta">
						<FormattedDate date={published} />
						{showUpdated && (
							<span class="updated">更新于 <FormattedDate date={modified} /></span>
						)}
						{isPost && (
							<span class="byline">作者 <a href="/author/" rel="author">YoTrade</a></span>
						)}
					</p>
					{tags.length > 0 && (
						<div class="post-tags">
							{tags.map((t) => (
								<a href={`/tags/${tagSlug(t)}/`}>{t}</a>
							))}
						</div>
					)}
				</header>

				{isPost && (
					<aside class="tile cta cta--top">
						<h3>不想折腾接码和虚拟卡？</h3>
						<p>
							ChatGPT Pro / Claude Max 官方订阅代充。美卡直冲美区官方，5–10 分钟到账，被砍单全额退。
							只接 ≥$100/月 的重度套餐。
						</p>
						<div class="actions">
							<a class="btn btn-primary" href={ctaHref}>查看套餐与价格 →</a>
						</div>
					</aside>
				)}

				<div class="prose">
					<slot />
				</div>
			</article>

			{isPost && (
				<aside class="tile cta cta--bottom">
					<h3>ChatGPT Pro / Claude Max 官方订阅代充</h3>
					<p>
						接码、虚拟卡、支付被拒、账号被砍——这些环节我们替你走完。美区官方直冲，
						操作期间不查看你的任何使用记录，5–10 分钟回执。
					</p>
					<p class="cta-plans">
						只服务重度用户：ChatGPT Pro ¥1,500/月 · Claude Max 5x ¥750/月 · Max 20x ¥1,500/月 · Claude Pro 年付 ¥1,500/年
					</p>
					<div class="actions">
						<a class="btn btn-primary" href={ctaHref}>查看套餐与下单 →</a>
						<a class="btn btn-secondary" href={ctaWechatHref}>微信咨询</a>
					</div>
				</aside>
			)}

			{related.length > 0 && (
				<section class="related">
					<h3>相关阅读</h3>
					<ul>
						{related.map((p) => (
							<li class="tile tile-link">
								<a href={`/blog/${p.id}/`}>
									<span class="t">{p.data.title}</span>
									<p class="desc">{p.data.description}</p>
								</a>
							</li>
						))}
					</ul>
				</section>
			)}
		</main>
		<Footer />
	</body>
</html>
